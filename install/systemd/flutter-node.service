[Unit]
Description=Flutter game-node daemon
Documentation=https://github.com/Flutter-Software/Flutter-Panel
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=flutter
Group=flutter
SupplementaryGroups=docker
WorkingDirectory=/opt/flutter-node
Environment=NODE_ENV=production
Environment=PATH=/opt/flutter-node/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=DAEMON_CONFIG=/opt/flutter-node/apps/daemon/data/config.json
Environment=DAEMON_DATA_DIR=/var/lib/flutter
Environment=NO_PROXY=127.0.0.1,localhost,::1
Environment=no_proxy=127.0.0.1,localhost,::1
ExecStartPre=/usr/bin/node /opt/flutter-node/scripts/link-shared.mjs
ExecStart=/usr/bin/npm run start -w @flutter-software/daemon
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=65535
SyslogIdentifier=flutter-daemon

[Install]
WantedBy=multi-user.target
