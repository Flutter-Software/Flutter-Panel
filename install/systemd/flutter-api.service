[Unit]
Description=Flutter panel API
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=flutter
Group=flutter
SupplementaryGroups=docker
WorkingDirectory=/opt/flutter
EnvironmentFile=/opt/flutter/.env
Environment=NODE_ENV=production
Environment=PATH=/opt/flutter/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/npm run start -w @flutter-software/api
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=65535
SyslogIdentifier=flutter-api

[Install]
WantedBy=multi-user.target
